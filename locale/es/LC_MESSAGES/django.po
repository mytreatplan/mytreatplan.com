#: accounts/templates/accounts/settings_shipping.html
msgid ""
"Where we send your physical products. When you order, we offer your default "
"address first."
msgstr ""
"Adónde enviamos sus productos físicos. Al hacer un pedido, le ofrecemos "
"primero su dirección predeterminada."

#: accounts/templates/accounts/settings_shipping.html
msgid "You have not added any shipping addresses yet."
msgstr "Todavía no ha añadido ninguna dirección de envío."

#: accounts/templates/accounts/settings_shipping.html
msgid "Add a shipping address"
msgstr "Añadir una dirección de envío"

#: accounts/templates/accounts/settings_shipping.html
#, python-format
