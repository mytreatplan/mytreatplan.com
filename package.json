{
  "name": "mytreatplan-com",
  "private": true,
  "description": "Front-end build for the mytreatplan.com Django project (Tailwind CSS and vendored HTMX).",
  "scripts": {
    "build:css": "tailwindcss -i assets/css/site.css -o static/css/site.css --minify",
    "watch:css": "tailwindcss -i assets/css/site.css -o static/css/site.css --watch",
    "vendor:htmx": "cp node_modules/htmx.org/dist/htmx.min.js static/js/htmx.min.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "htmx.org": "2.0.11",
    "tailwindcss": "4.3.3"
  }
}
