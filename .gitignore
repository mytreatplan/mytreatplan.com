# OS
.DS_Store

# Secrets (copy settings.env.example to settings.env)
settings.env

# Django settings hold no secrets and must be tracked (overrides global ignores)
!mytreatplan/settings.py

# Release SHA, written on the server by deploy/release.sh
/REVISION
# The release marker the CI build adds to the tarball (deploy/release.sh requires it)
/deploy/release-ready

# Logs
*.log

# Python
__pycache__/
*.pyc
.pytest_cache/

# Compiled translations (build with `python manage.py compilemessages`)
*.mo

# Django collectstatic output
static_root/

# Node / Tailwind build
node_modules/
static/css/site.css

# Spec Driven Development: BMAD
.agents/
.claude/
skills-lock.json

# IDEs
.vscode/
.idea/

# BMad rendered workflow cache
_bmad/render/

# SSH keys and certificates: never commit (keys live in ~/.ssh)
id_*
*.pem
*.key
*_staging
*_staging.pub
*_production
*_production.pub
