# Installed by deploy/provision.sh to /etc/systemd/system/mytp-gunicorn.service.
# Serves the active release (/srv/mytp/current) on the socket from mytp-gunicorn.socket.
# Deploys restart it with `sudo systemctl restart mytp-gunicorn` (deploy/sudoers/mytp-deploy).
[Unit]
Description=MyTreatplan Gunicorn (Django)
Requires=mytp-gunicorn.socket
After=network.target

[Service]
Type=notify
NotifyAccess=main
User=mytp
Group=mytp
# `current` is resolved when the service starts, so a restart picks up a new release.
WorkingDirectory=/srv/mytp/current
ExecStart=/srv/mytp/current/venv/bin/gunicorn mytreatplan.wsgi:application \
    --workers 3 \
    --timeout 30 \
    --access-logfile - \
    --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=10
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
UMask=0027

[Install]
WantedBy=multi-user.target
