# Template for /srv/mytp/shared/settings.env on the staging server (owner mytp, mode 600).
# Each release links it in as settings.env beside manage.py. Fill in the two secrets
# on the server only; never commit the filled-in file.
SECRET_KEY=
DATABASE_URL=postgres://<db-user>:<db-password>@<db-host>:<db-port>/mytreatplan

DEBUG=False
ALLOWED_HOSTS=dev.mytpdso.com
CSRF_TRUSTED_ORIGINS=https://dev.mytpdso.com
SITE_URL=https://dev.mytpdso.com
ROBOTS_NOINDEX=True
PORTAL_ENABLED=True
# Signup verification codes: the fake writes each code to the server journal
# (journalctl -u mytp-gunicorn) and stores none. Twilio Verify replaces it later.
VERIFICATION_PROVIDER=signup.verification.FakeVerificationProvider
SECURE_HSTS_SECONDS=3600
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/srv/mytp/shared/db-ca.pem

# Sentry (EU region). Paste the project's DSN (https://<key>@<org>.ingest.de.sentry.io/<id>)
# on the server only; empty turns Sentry off. See deploy/README.md.
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging

# Off-region backups (manage.py backupdb, nightly; see deploy/README.md "Backups and
# restore"). OVHcloud Object Storage in SBG, i.e. not the database's region (GRA).
# The access and secret keys belong to an S3 user that can write and read the bucket
# but not delete; fill them in on the server only. BACKUP_AGE_RECIPIENT is the age
# *public* key (age1...); the private identity stays in the team password manager.
BACKUP_S3_ENDPOINT=https://s3.sbg.io.cloud.ovh.net
BACKUP_S3_REGION=sbg
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_PREFIX=staging/
BACKUP_AGE_RECIPIENT=

# OVHcloud KMS (manage.py kmscheck, daily; see deploy/README.md step 11 and "Keys (KMS)").
# KMS_ENDPOINT is https://<region>.okms.ovh.net for the France region chosen at setup;
# KMS_OKMS_ID and KMS_SERVICE_KEY_ID come from the KMS panel. KMS_CLIENT_CERT and
# KMS_CLIENT_KEY are the paths of the access certificate and its private key in
# /srv/mytp/shared/ (owner mytp, mode 600), e.g. /srv/mytp/shared/kms-client.crt and
# /srv/mytp/shared/kms-client.key. KMS_CA_FILE stays empty (system CAs) unless OVHcloud
# says otherwise. Fill them in on the server only.
KMS_ENDPOINT=
KMS_OKMS_ID=
KMS_SERVICE_KEY_ID=
KMS_CLIENT_CERT=
KMS_CLIENT_KEY=
KMS_CA_FILE=

# Field encryption and blind index (story 2.2; see deploy/README.md step 12). Generate
# them on the server with `manage.py generate_field_keys`, fill them in on the server
# only, and keep a copy in the team password manager ("MyTreatplan staging field keys"):
# a lost key cannot be reissued and its data stays unreadable. FIELD_ENCRYPTION_KEYS is
# `<key_id>:<base64 key>`, comma-separated, current key first.
FIELD_ENCRYPTION_KEYS=
BLIND_INDEX_KEY=
