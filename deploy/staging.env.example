# Template for /srv/mytp-<site>/shared/settings.env on the staging server (owner
# mytp-<site>, mode 600), written for the `dev` site; for another site change SITE, the
# hosts and the /srv/mytp-dev paths. Each release links it in as settings.env beside
# manage.py. Fill in the two secrets on the server only; never commit the filled-in file.
# SITE names the site (deploy/provision.sh <site>); the release command refuses a
# settings.env whose SITE is not the site it deploys.
#
# dev-ae differences (the REGION=ae staging site beside dev; deploy/README.md "Add dev-ae"):
#   SITE=dev-ae and REGION=ae
#   SECRET_KEY: its own, never dev's
#   DATABASE_URL: database and user mytp_dev_ae on dev's PostgreSQL service, password
#     URL-encoded, ending in /mytp_dev_ae?sslmode=require
#   ALLOWED_HOSTS=dev-ae.mytpdso.com, CSRF_TRUSTED_ORIGINS and SITE_URL
#     https://dev-ae.mytpdso.com
#   DB_SSLROOTCERT=/srv/mytp-dev-ae/shared/db-ca.pem (a copy of dev's CA)
#   BACKUP_PREFIX=staging-dev-ae/ (same bucket and S3 user as dev; the bucket needs its own
#     30-day lifecycle rule for this prefix, deploy/README.md "Add dev-ae" step 6)
#   SENTRY_ENVIRONMENT=dev-ae (its own Sentry environment, AD-24)
#   BACKUP_AGE_RESTORE_RECIPIENT and RESTORE_TEST_DATABASE_URL: its own (restore identity
#     generated as mytp-dev-ae; scratch database and user dev_ae_restore_test), never dev's
#   KMS_CLIENT_CERT and KMS_CLIENT_KEY: /srv/mytp-dev-ae/shared/kms-client.crt and .key
#     (copies of dev's, owner mytp-dev-ae); the other KMS_* values as dev's (staging only:
#     dev-ae's keys are wrapped by dev's EU service key, never a UAE one)
#   FIELD_KMS_KEYS and BLIND_INDEX_KMS_KEY: its own, generated as mytp-dev-ae;
#     FIELD_ENCRYPTION_KEYS and BLIND_INDEX_KEY stay empty
#   No STORAGE_* lines (its own EU bucket comes later; STORAGE_SAMPLE_UPLOADS=False)
#   REGION_SITE_URL_EU=https://dev.mytpdso.com instead of dev's REGION_SITE_URL_AE
#   Everything else (Turnstile, Twilio, email, Sentry, backup bucket keys) as dev's; dev's
#   Turnstile widget lists dev-ae.mytpdso.com as a hostname.
SITE=dev
# The region profile (regions/profiles.py, AD-13): eu for dev, ae for dev-ae. It sets the
# time zone, languages, currencies and the default hosts; ALLOWED_HOSTS,
# CSRF_TRUSTED_ORIGINS and SITE_URL below override its production domains.
REGION=eu
SECRET_KEY=
DATABASE_URL=postgres://<db-user>:<db-password>@<db-host>:<db-port>/mytreatplan

DEBUG=False
ALLOWED_HOSTS=dev.mytpdso.com
CSRF_TRUSTED_ORIGINS=https://dev.mytpdso.com
SITE_URL=https://dev.mytpdso.com
# The other region's staging site, where the country map sends a person whose country
# that region serves (regions.countries, epic-regions entry 1). REGION_SITE_URL_<CODE>
# overrides that region's production site URL (https://mytreatplan.ae here); dev-ae sets
# REGION_SITE_URL_EU=https://dev.mytpdso.com instead.
REGION_SITE_URL_AE=https://dev-ae.mytpdso.com
ROBOTS_NOINDEX=True
# The checks fake the visitor's country with the header `X-MyTP-Geo-Country: SA`
# (regions.geoip). Staging only: `check` fails when it is on without ROBOTS_NOINDEX.
GEOIP_OVERRIDE_HEADER_ENABLED=True
PORTAL_ENABLED=True
# Signup verification codes: the fake writes each code to the server journal
# (journalctl -u mytp-dev-gunicorn) and stores none; `check --deploy` fails while it is
# selected (mytp_publicsite.E006). Switch to Twilio Verify once the Verify service and its
# SendGrid email integration exist (deploy/README.md, "Twilio Verify"):
# VERIFICATION_PROVIDER=signup.twilio_verify.TwilioVerifyProvider
VERIFICATION_PROVIDER=signup.verification.FakeVerificationProvider
# With the fake, mobile +34 699 000 001 has no WhatsApp (the code goes by SMS) and every
# send to +34 699 000 002 fails, to try both paths.
# Twilio Verify credentials: type them in on the server only (never paste them anywhere
# else). Required while the Twilio provider is selected (signup.E001).
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=
# True once the WhatsApp sender is approved; until then mobile codes go by SMS.
TWILIO_WHATSAPP_ENABLED=False
# Signup step 1 CAPTCHA (Cloudflare Turnstile widget for dev.mytpdso.com, managed mode).
# Paste the site key and the secret key from the Cloudflare dashboard on the server only;
# left unset (or empty), Cloudflare's always-pass test keys apply and nothing is checked.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Transactional email (password reset, contact form) over SMTP through the company's own
# mail service, sent from noreply@mytreatplan.com (deploy/README.md, "Email"). Type the
# host, user and password on the server only. EMAIL_USE_SSL=True for implicit TLS;
# otherwise STARTTLS. The port follows (465 or 587) unless EMAIL_PORT is set. With
# EMAIL_HOST empty, mail only goes to the journal and `check --deploy` fails (mail.E001).
# EMAIL_PORT, EMAIL_USE_SSL and EMAIL_TIMEOUT need a value or no line at all: an empty
# `EMAIL_PORT=` stops the app at startup.
EMAIL_HOST=
EMAIL_USE_SSL=False
EMAIL_HOST_USER=noreply@mytreatplan.com
EMAIL_HOST_PASSWORD=
# EMAIL_PORT=587
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=MyTreatPlan <noreply@mytreatplan.com>
# SERVER_EMAIL=MyTreatPlan <noreply@mytreatplan.com>
# The inbox that receives the contact form's messages; empty fails `check --deploy`.
CONTACT_INBOX=webform@mytreatplan.com
# Signup, login and password reset per-IP limits per hour (defaults shown); change and
# restart mytp-dev-gunicorn.
# SIGNUP_IP_LIMIT_STARTS=60
# SIGNUP_IP_LIMIT_EMAIL_CHECKS=180
# SIGNUP_IP_LIMIT_CODE_SENDS=120
# SIGNUP_IP_LIMIT_LOGIN_ATTEMPTS=60
# SIGNUP_IP_LIMIT_RESET_REQUESTS=20
# Days an erased account is kept as evidence before the daily `purgeerased` job deletes
# it. 1 on staging, for the check, until the lawyer gives the real value. No default:
# unset, the admin's Erase account action refuses and `check --deploy` fails.
ACCOUNT_ERASURE_RETENTION_DAYS=1
SECURE_HSTS_SECONDS=3600
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/srv/mytp-dev/shared/db-ca.pem

# Sentry (EU region). Paste the project's DSN (https://<key>@<org>.ingest.de.sentry.io/<id>)
# on the server only; empty turns Sentry off. See deploy/README.md. The environment is the
# site's name (AD-24): dev here, dev-ae on dev-ae (admindev on the admin site).
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev

# Off-region backups (manage.py backupdb, nightly; see deploy/README.md "Backups and
# restore"). OVHcloud Object Storage in SBG, i.e. not the database's region (GRA).
# The access and secret keys belong to an S3 user that can write and read the bucket
# but not delete; fill them in on the server only. BACKUP_AGE_RECIPIENT is the age
# *public* key (age1...); the private identity stays in the team password manager.
# BACKUP_PREFIX is the site's own, staging-<site>/, with its own 30-day lifecycle rule.
BACKUP_S3_ENDPOINT=https://s3.sbg.io.cloud.ovh.net
BACKUP_S3_REGION=sbg
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_PREFIX=staging-dev/
BACKUP_AGE_RECIPIENT=

# The weekly restore test (the `restoretest` job; deploy/README.md "Restore test (weekly,
# on the server)"). BACKUP_AGE_RESTORE_RECIPIENT is the public key printed by
# `manage.py generate_restore_identity` (its identity stays in
# /srv/mytp-dev/shared/restore-identity.json, wrapped by the KMS key; the team's key never
# comes here). RESTORE_TEST_DATABASE_URL is the scratch database and its own user on the
# site's PostgreSQL service, password URL-encoded, typed on the server only:
# postgres://dev_restore_test:<password>@<db-host>:<db-port>/dev_restore_test
# DB_SSLMODE and DB_SSLROOTCERT apply to it too.
BACKUP_AGE_RESTORE_RECIPIENT=
RESTORE_TEST_DATABASE_URL=

# Object storage (AD-9; deploy/README.md "Object storage"). On dev only for now: the
# region's file bucket in GRA (e.g. mytp-dev-files; never the backup bucket). The access
# and secret keys belong to an S3 user limited to that bucket (read, write, delete; no
# bucket configuration); fill them in on the server only. STORAGE_ENDPOINT defaults to
# the region profile's and STORAGE_REGION to the region in it. STORAGE_CORS_ORIGINS is
# the site's origin (empty: SITE_URL). After a change to either of the last two, run
# `manage.py storage_bucket --apply` with the bucket owner's keys. STORAGE_SAMPLE_UPLOADS
# turns on the staff-only sample page /en/storage/sample/ (staging only; never on dev-ae).
STORAGE_ENDPOINT=https://s3.gra.io.cloud.ovh.net
STORAGE_REGION=gra
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_CORS_ORIGINS=
STORAGE_ABORT_INCOMPLETE_DAYS=7
STORAGE_SAMPLE_UPLOADS=False
# clamd's socket on the host (provision.sh installs ClamAV; "Object storage" ->
# "Scanning"). Required whenever STORAGE_BUCKET is set (check storage.E004): the scan
# worker streams every upload to it, and only scanned files are downloadable.
STORAGE_CLAMD_SOCKET=/run/clamav/clamd.ctl

# OVHcloud KMS (manage.py kmscheck, daily; see deploy/README.md step 11 and "Keys (KMS)").
# KMS_ENDPOINT is https://<region>.okms.ovh.net for the France region chosen at setup;
# KMS_OKMS_ID and KMS_SERVICE_KEY_ID come from the KMS panel. KMS_CLIENT_CERT and
# KMS_CLIENT_KEY are the paths of the access certificate and its private key in
# /srv/mytp-dev/shared/ (owner mytp-dev, mode 600), e.g. /srv/mytp-dev/shared/kms-client.crt
# and /srv/mytp-dev/shared/kms-client.key. KMS_CA_FILE stays empty (system CAs) unless OVHcloud
# says otherwise. Fill them in on the server only.
KMS_ENDPOINT=
KMS_OKMS_ID=
KMS_SERVICE_KEY_ID=
KMS_CLIENT_CERT=
KMS_CLIENT_KEY=
KMS_CA_FILE=

# Plain field keys: the pre-KMS setup (story 2.2) and the transition during "Move to the
# KMS provider" only (deploy/README.md step 12). A new environment (production) leaves
# them empty and starts directly with the KMS keys below (`manage.py
# generate_kms_field_key`). While they are used: generated on the server with
# `manage.py generate_field_keys`, filled in on the server only, and a copy kept in the
# team password manager ("MyTreatplan staging field keys"): a lost key cannot be
# reissued and its data stays unreadable. FIELD_ENCRYPTION_KEYS is
# `<key_id>:<base64 key>`, comma-separated, current key first.
FIELD_ENCRYPTION_KEYS=
BLIND_INDEX_KEY=
# KMS key provider (story 2.12; step 12, "Move to the KMS provider"). Replaces the two
# plain keys above, which stay only during the move (FIELD_ENCRYPTION_KEYS for decryption
# only) and are then deleted. FIELD_KMS_KEYS is `<key_id>:<wrapped key>`, comma-separated,
# current first, and BLIND_INDEX_KMS_KEY one wrapped key, both printed by
# `manage.py generate_kms_field_key`. Wrapped keys are useless without the KMS service key.
# Copy the key ids and wrapped values (never a plain key) to the password manager entry
# "MyTreatplan staging KMS" at every generation or rotation; keep superseded ones 30 days.
# FIELD_KEY_PROVIDER=accounts.crypto.KMSKeyProvider
# FIELD_KMS_KEYS=
# BLIND_INDEX_KMS_KEY=

# The interface with the admin site (deploy/README.md, "Interface with the admin site").
# INTERFACE_SIGNING_KMS_KEY is this site's signing key, `<kid>:<wrapped key>`, printed by
# `manage.py generate_interface_signing_key <kid>` (its second line, the public key, goes
# to admindev's `add_peer_key`). INTERFACE_PEER_KEYS lists admindev's public key(s),
# `admindev:<kid>:<public key>`, from admindev's own generate command. Public keys are
# not secret; the wrapped key is useless without the KMS service key, but stays on the
# server like the field keys. dev-ae: the same lines with its own key.
INTERFACE_SIGNING_KMS_KEY=
INTERFACE_PEERS=admindev=https://admindev.mytpdso.com
INTERFACE_PEER_KEYS=
# The outbox (epic-admin-interface entry 3) sends events to the only INTERFACE_PEERS entry
# (or INTERFACE_ADMIN_SITE, when several).
# INTERFACE_ADMIN_SITE=admindev
