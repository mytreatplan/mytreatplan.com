# Rendered by deploy/provision.sh to /etc/nginx/sites-available/mytp-__SITE__.conf, one
# per site (__SITE__ is the site name, e.g. dev; __DOMAIN__ its domain, e.g.
# dev.mytpdso.com).
# Until the Let's Encrypt certificate exists, only the part above the
# __HTTPS_BEGIN__ marker is installed, so certbot can answer the HTTP challenge.
# The site's redirect-only names (provision.sh EXTRA_DOMAINS, production EU only) fill the
# EXTRA_DOMAINS placeholder. Unset, the placeholder is dropped with the space before it,
# and so is the section between the EXTRA_BEGIN and EXTRA_END markers.
# The /api/ allowlist (provision.sh API_PEER_IPS, production only) replaces the
# API_ALLOW placeholder with a line per address; unset, the section between the
# API_ALLOW_BEGIN and API_ALLOW_END markers is dropped.

upstream mytp-__SITE__-gunicorn {
    server unix:/run/mytp-__SITE__-gunicorn.sock fail_timeout=0;
}

# HTTP: ACME challenges only; everything else goes to HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__ __EXTRA_DOMAINS__;

    location /.well-known/acme-challenge/ {
        auth_basic off;
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://__DOMAIN__$request_uri;
    }
}

# __HTTPS_BEGIN__
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:mytp-__SITE__-ssl:10m;
    ssl_session_timeout 1d;

    client_max_body_size 10m;

    # Staging: the whole site is behind the team password.
    auth_basic "MyTreatplan staging";
    auth_basic_user_file /etc/nginx/mytp-__SITE__.htpasswd;

    location /.well-known/acme-challenge/ {
        auth_basic off;
        root /var/www/letsencrypt;
    }

    location /static/ {
        alias /srv/mytp-__SITE__/current/static_root/;
        expires 1h;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    # Uptime probe (UptimeRobot): no password. Django answers only `ok`/`unavailable`
    # and adds X-Robots-Tag like on every other response.
    location = /healthz {
        auth_basic off;
        proxy_pass http://mytp-__SITE__-gunicorn;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_read_timeout 15s;
    }

    # The interface between the admin site and the portals (AD-4): every request is signed
    # (Ed25519, checked by Django), so no team password; bodies up to 1 MB. Production
    # lets only the peers' addresses through (provision.sh API_PEER_IPS; every other
    # address gets 403); without API_PEER_IPS (staging) the section between the API_ALLOW
    # markers is dropped.
    location /api/ {
        auth_basic off;
# __API_ALLOW_BEGIN__
        __API_ALLOW__
        deny all;
# __API_ALLOW_END__
        client_max_body_size 1m;
        proxy_pass http://mytp-__SITE__-gunicorn;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_read_timeout 30s;
    }

    location / {
        proxy_pass http://mytp-__SITE__-gunicorn;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_read_timeout 60s;
    }
}
# __EXTRA_BEGIN__
# Redirect-only names: one hop to the main domain, path and query kept. No password, no
# app. Installed only once the certificate covers these names.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __EXTRA_DOMAINS__;

    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:mytp-__SITE__-ssl:10m;
    ssl_session_timeout 1d;

    return 301 https://__DOMAIN__$request_uri;
}
# __EXTRA_END__
