# Copy to settings.env (beside manage.py) for local development.
# Environment variables override values in this file. Never commit settings.env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# Region profile (regions/profiles.py): eu (time zone, languages, default hosts) or ae.
REGION=eu
DATABASE_URL=postgres://mytp_db:change-me@localhost:5432/mytreatplan
ALLOWED_HOSTS=localhost,127.0.0.1
# Public address used in canonical, Open Graph and sitemap URLs (no trailing slash).
SITE_URL=http://localhost:8000
# Field encryption and blind index keys (required; `check` fails without them).
# Generate them with `python manage.py generate_field_keys` and paste its two lines
# here. Keep your own copy: data encrypted with a lost key cannot be read again.
FIELD_ENCRYPTION_KEYS=
BLIND_INDEX_KEY=

# --- Staging / production (leave unset for local development) ---
# Origins trusted for HTTPS form posts (CSV, scheme + host).
# CSRF_TRUSTED_ORIGINS=https://dev.mytpdso.com
# With DEBUG=False the app forces HTTPS (secure cookies, proxy SSL header, redirect).
# SECURE_SSL_REDIRECT=True
# HSTS max-age in seconds (staging: short, e.g. 3600; no preload). Default 0 = off.
# SECURE_HSTS_SECONDS=3600
# PostgreSQL TLS. With DEBUG=False, `check --deploy` requires verify-full or verify-ca.
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/etc/mytreatplan/db-ca.pem
# Staging: noindex header on every response and a disallow-all robots.txt.
# ROBOTS_NOINDEX=True
# Route the portal pages (signup, login, ...). Staging only, for now.
# PORTAL_ENABLED=True
# Signup verification codes. The default fake prints each code to the console
# (runserver output); keep it for development. Staging and production use Twilio Verify
# (deploy/README.md, "Twilio Verify").
# VERIFICATION_PROVIDER=signup.verification.FakeVerificationProvider
# With the fake, mobile +34 699 000 001 has no WhatsApp (the code goes by SMS) and every
# send to +34 699 000 002 fails (signup.verification.FAKE_*_NUMBER).
# Twilio Verify, only with VERIFICATION_PROVIDER=signup.twilio_verify.TwilioVerifyProvider.
# All four are required then (signup.E001); never commit real values.
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_VERIFY_SERVICE_SID=
# Off (default) until the WhatsApp sender is approved: mobile codes go by SMS.
# TWILIO_WHATSAPP_ENABLED=False
# Transactional email over SMTP (deploy/README.md, "Email"). Empty EMAIL_HOST (default):
# messages are printed to the console instead of sent. EMAIL_USE_SSL=True for implicit TLS,
# otherwise STARTTLS; the port follows (465 or 587) unless set. EMAIL_PORT, EMAIL_USE_SSL
# and EMAIL_TIMEOUT need a value or no line at all (empty stops the app at startup).
# EMAIL_HOST=
# EMAIL_USE_SSL=False
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=MyTreatPlan <noreply@mytreatplan.com>
# SERVER_EMAIL=MyTreatPlan <noreply@mytreatplan.com>
# Support contact shown when a signup code cannot be sent or is used up (default shown).
# SIGNUP_SUPPORT_EMAIL=sayhi@mytreatplan.com
# The inbox that receives the contact form's messages. Empty (default): they are only
# stored, and `check --deploy` fails with DEBUG off.
# CONTACT_INBOX=webform@mytreatplan.com
# Field key provider; the environment one (default, development) reads
# FIELD_ENCRYPTION_KEYS and BLIND_INDEX_KEY. Staging/production use the KMS provider with
# KMS-wrapped keys from `manage.py generate_kms_field_key` (deploy/README.md, step 12).
# FIELD_KEY_PROVIDER=accounts.crypto.EnvKeyProvider
# FIELD_KMS_KEYS=
# BLIND_INDEX_KMS_KEY=
# Signup step 1 external checks (defaults shown). Timeout in seconds for each call.
# PWNED_PASSWORDS_API_URL=https://api.pwnedpasswords.com/range/
# DISPOSABLE_EMAIL_API_URL=https://disposable.debounce.io/
# EXTERNAL_CHECK_TIMEOUT=3
# Signup step 1 CAPTCHA (Cloudflare Turnstile). Unset = Cloudflare's test keys (always
# pass). Staging/production: the widget's keys from the Cloudflare dashboard; the secret
# key goes here only.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
# Signup, login and password reset per-IP limits per hour (defaults shown); a restart
# applies a change.
# SIGNUP_IP_LIMIT_STARTS=60
# SIGNUP_IP_LIMIT_EMAIL_CHECKS=180
# SIGNUP_IP_LIMIT_CODE_SENDS=120
# SIGNUP_IP_LIMIT_LOGIN_ATTEMPTS=60
# SIGNUP_IP_LIMIT_RESET_REQUESTS=20
# Days an erased account is kept as evidence before the daily purge deletes it. No
# default (the lawyer sets it): unset, the admin's Erase account action refuses and
# `check --deploy` fails.
# ACCOUNT_ERASURE_RETENTION_DAYS=
